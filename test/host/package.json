{
  "name": "daily-plan-test-host",
  "publisher": "local-test",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.57.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "leetCodeStudyPlanDailyPlan",
          "name": "Daily plan test"
        },
        {
          "id": "leetCodeStudyPlanExplorer",
          "name": "Standalone problems test"
        },
        {
          "id": "leetCodeExplorer",
          "name": "Upstream problems fixture"
        },
        {
          "id": "leetCodeStudyPlanPersonalLists",
          "name": "Personal lists test"
        }
      ]
    },
    "configuration": {
      "title": "Daily plan test",
      "properties": {
        "leetcodeStudyPlan.dailyPlan.path": {
          "type": "string",
          "default": "data/custom-plan.json",
          "scope": "resource"
        }
      }
    }
  }
}

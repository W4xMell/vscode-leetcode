{
    "name": "vscode-leetcode-study-plan",
    "displayName": "LeetCode Study Plan",
    "description": "Solve LeetCode problems in VS Code with workspace-defined custom study plans.",
    "version": "0.1.0",
    "author": "W4xMell",
    "publisher": "W4xMell",
    "license": "MIT",
    "icon": "resources/LeetCode.png",
    "engines": {
        "vscode": "^1.57.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/W4xMell/vscode-leetcode-study-plan"
    },
    "homepage": "https://github.com/W4xMell/vscode-leetcode-study-plan",
    "categories": [
        "Other",
        "Snippets"
    ],
    "keywords": [
        "leetcode",
        "algorithm",
        "interview",
        "study-plan",
        "custom-plan"
    ],
    "preview": true,
    "activationEvents": [
        "onCommand:leetcodeStudyPlan.toggleLeetCodeCn",
        "onCommand:leetcodeStudyPlan.signin",
        "onCommand:leetcodeStudyPlan.signout",
        "onCommand:leetcodeStudyPlan.manageSessions",
        "onCommand:leetcodeStudyPlan.refreshExplorer",
        "onCommand:leetcodeStudyPlan.pickOne",
        "onCommand:leetcodeStudyPlan.showProblem",
        "onCommand:leetcodeStudyPlan.previewProblem",
        "onCommand:leetcodeStudyPlan.searchProblem",
        "onCommand:leetcodeStudyPlan.testSolution",
        "onCommand:leetcodeStudyPlan.submitSolution",
        "onCommand:leetcodeStudyPlan.switchDefaultLanguage",
        "onCommand:leetcodeStudyPlan.problems.sort",
        "onView:leetCodeStudyPlanExplorer",
        "workspaceContains:data/notion-plan.json",
        "onView:leetCodeStudyPlanDailyPlan",
        "workspaceContains:data/custom-plan.json"
    ],
    "main": "./out/src/extension",
    "contributes": {
        "commands": [
            {
                "command": "leetcodeStudyPlan.deleteCache",
                "title": "Delete Cache",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.toggleLeetCodeCn",
                "title": "Switch Endpoint",
                "category": "LeetCode Study Plan",
                "icon": "$(globe)"
            },
            {
                "command": "leetcodeStudyPlan.signin",
                "title": "Sign In",
                "category": "LeetCode Study Plan",
                "icon": "$(sign-in)"
            },
            {
                "command": "leetcodeStudyPlan.signout",
                "title": "Sign Out",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.manageSessions",
                "title": "Manage Sessions",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.refreshExplorer",
                "title": "Refresh",
                "category": "LeetCode Study Plan",
                "icon": "$(refresh)"
            },
            {
                "command": "leetcodeStudyPlan.pickOne",
                "title": "Pick One",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.showProblem",
                "title": "Show Problem",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.previewProblem",
                "title": "Preview Problem",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.searchProblem",
                "title": "Search Problem",
                "category": "LeetCode Study Plan",
                "icon": "$(search)"
            },
            {
                "command": "leetcodeStudyPlan.showSolution",
                "title": "Show Top Voted Solution",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.testSolution",
                "title": "Test in LeetCode",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.submitSolution",
                "title": "Submit to LeetCode",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.addFavorite",
                "title": "Add to Favorite List",
                "category": "LeetCode Study Plan",
                "icon": {
                    "light": "resources/light/like.png",
                    "dark": "resources/dark/like.png"
                }
            },
            {
                "command": "leetcodeStudyPlan.removeFavorite",
                "title": "Remove from Favorite List",
                "category": "LeetCode Study Plan",
                "icon": {
                    "light": "resources/light/dislike.png",
                    "dark": "resources/dark/dislike.png"
                }
            },
            {
                "command": "leetcodeStudyPlan.switchDefaultLanguage",
                "title": "Switch Default Language",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.problems.sort",
                "title": "Sort Problems",
                "category": "LeetCode Study Plan",
                "icon": "$(sort-precedence)"
            },
            {
                "command": "leetcodeStudyPlan.dailyPlan.refresh",
                "title": "Refresh Study Plan",
                "category": "LeetCode Study Plan",
                "icon": "$(refresh)"
            },
            {
                "command": "leetcodeStudyPlan.dailyPlan.preview",
                "title": "Preview Problem",
                "category": "LeetCode Study Plan"
            },
            {
                "command": "leetcodeStudyPlan.dailyPlan.codeNow",
                "title": "Code Now",
                "category": "LeetCode Study Plan",
                "icon": "$(code)"
            },
            {
                "command": "leetcodeStudyPlan.dailyPlan.openSource",
                "title": "Open Source Link",
                "category": "LeetCode Study Plan",
                "icon": "$(link-external)"
            },
            {
                "command": "leetcodeStudyPlan.dailyPlan.toggleDone",
                "title": "Toggle Practice Completion",
                "category": "LeetCode Study Plan",
                "icon": "$(check)"
            },
            {
                "command": "leetcodeStudyPlan.dailyPlan.selectPlan",
                "title": "Select Study Plan JSON",
                "category": "LeetCode Study Plan",
                "icon": "$(folder-opened)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "leetcode-study-plan",
                    "title": "LeetCode Study Plan",
                    "icon": "resources/LeetCode.svg"
                }
            ]
        },
        "views": {
            "leetcode-study-plan": [
                {
                    "id": "leetCodeStudyPlanExplorer",
                    "name": "Problems"
                },
                {
                    "id": "leetCodeStudyPlanDailyPlan",
                    "name": "Study Plans"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "leetcodeStudyPlan.toggleLeetCodeCn",
                    "when": "view == leetCodeStudyPlanExplorer",
                    "group": "navigation@0"
                },
                {
                    "command": "leetcodeStudyPlan.signin",
                    "when": "view == leetCodeStudyPlanExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "leetcodeStudyPlan.searchProblem",
                    "when": "view == leetCodeStudyPlanExplorer",
                    "group": "navigation@2"
                },
                {
                    "command": "leetcodeStudyPlan.refreshExplorer",
                    "when": "view == leetCodeStudyPlanExplorer",
                    "group": "navigation@3"
                },
                {
                    "command": "leetcodeStudyPlan.signout",
                    "when": "view == leetCodeStudyPlanExplorer",
                    "group": "overflow@1"
                },
                {
                    "command": "leetcodeStudyPlan.pickOne",
                    "when": "view == leetCodeStudyPlanExplorer",
                    "group": "overflow@2"
                },
                {
                    "command": "leetcodeStudyPlan.problems.sort",
                    "when": "view == leetCodeStudyPlanExplorer",
                    "group": "overflow@3"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.refresh",
                    "when": "view == leetCodeStudyPlanDailyPlan",
                    "group": "navigation"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.selectPlan",
                    "when": "view == leetCodeStudyPlanDailyPlan",
                    "group": "navigation@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "leetcodeStudyPlan.previewProblem",
                    "when": "view == leetCodeStudyPlanExplorer && viewItem =~ /problem*/",
                    "group": "leetcode@1"
                },
                {
                    "command": "leetcodeStudyPlan.showProblem",
                    "when": "view == leetCodeStudyPlanExplorer && viewItem =~ /problem*/",
                    "group": "leetcode@2"
                },
                {
                    "command": "leetcodeStudyPlan.showSolution",
                    "when": "view == leetCodeStudyPlanExplorer && viewItem =~ /problem*/",
                    "group": "leetcode@3"
                },
                {
                    "command": "leetcodeStudyPlan.addFavorite",
                    "when": "view == leetCodeStudyPlanExplorer && viewItem == problem",
                    "group": "inline"
                },
                {
                    "command": "leetcodeStudyPlan.removeFavorite",
                    "when": "view == leetCodeStudyPlanExplorer && viewItem == problem-favorite",
                    "group": "inline"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.codeNow",
                    "when": "view == leetCodeStudyPlanDailyPlan && viewItem =~ /^dailyPlanProblem/",
                    "group": "inline@1"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.preview",
                    "when": "view == leetCodeStudyPlanDailyPlan && viewItem =~ /^dailyPlanProblem/",
                    "group": "practice@1"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.codeNow",
                    "when": "view == leetCodeStudyPlanDailyPlan && viewItem =~ /^dailyPlanProblem/",
                    "group": "practice@2"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.toggleDone",
                    "when": "view == leetCodeStudyPlanDailyPlan && viewItem =~ /^dailyPlanProblem/",
                    "group": "practice@3"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.openSource",
                    "when": "view == leetCodeStudyPlanDailyPlan",
                    "group": "source@1"
                }
            ],
            "commandPalette": [
                {
                    "command": "leetcodeStudyPlan.showProblem",
                    "when": "never"
                },
                {
                    "command": "leetcodeStudyPlan.showSolution",
                    "when": "never"
                },
                {
                    "command": "leetcodeStudyPlan.previewProblem",
                    "when": "never"
                },
                {
                    "command": "leetcodeStudyPlan.addFavorite",
                    "when": "never"
                },
                {
                    "command": "leetcodeStudyPlan.removeFavorite",
                    "when": "never"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.preview",
                    "when": "false"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.codeNow",
                    "when": "false"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.toggleDone",
                    "when": "false"
                },
                {
                    "command": "leetcodeStudyPlan.dailyPlan.openSource",
                    "when": "false"
                }
            ],
            "explorer/context": [
                {
                    "command": "leetcodeStudyPlan.testSolution",
                    "when": "explorerResourceIsFolder == false",
                    "group": "leetcode@1"
                },
                {
                    "command": "leetcodeStudyPlan.submitSolution",
                    "when": "explorerResourceIsFolder == false",
                    "group": "leetcode@2"
                }
            ],
            "editor/context": [
                {
                    "submenu": "leetcodeStudyPlan.editorAction"
                }
            ],
            "leetcodeStudyPlan.editorAction": [
                {
                    "command": "leetcodeStudyPlan.testSolution",
                    "group": "leetcode@1"
                },
                {
                    "command": "leetcodeStudyPlan.submitSolution",
                    "group": "leetcode@2"
                },
                {
                    "command": "leetcodeStudyPlan.showSolution",
                    "group": "leetcode@3"
                },
                {
                    "command": "leetcodeStudyPlan.previewProblem",
                    "group": "leetcode@4"
                }
            ]
        },
        "submenus": [
            {
                "id": "leetcodeStudyPlan.editorAction",
                "label": "LeetCode Study Plan"
            }
        ],
        "configuration": [
            {
                "title": "LeetCode Study Plan",
                "properties": {
                    "leetcodeStudyPlan.hideSolved": {
                        "type": "boolean",
                        "default": false,
                        "scope": "application",
                        "description": "Hide solved problems."
                    },
                    "leetcodeStudyPlan.defaultLanguage": {
                        "type": "string",
                        "enum": [
                            "bash",
                            "c",
                            "cpp",
                            "csharp",
                            "golang",
                            "java",
                            "javascript",
                            "kotlin",
                            "mysql",
                            "php",
                            "python",
                            "python3",
                            "ruby",
                            "rust",
                            "scala",
                            "swift",
                            "typescript"
                        ],
                        "scope": "application",
                        "description": "Default language for solving the problems."
                    },
                    "leetcodeStudyPlan.showDescription": {
                        "type": "string",
                        "default": "In Webview",
                        "enum": [
                            "In Webview",
                            "In File Comment",
                            "Both",
                            "None"
                        ],
                        "enumDescriptions": [
                            "Show the problem description in a new webview window",
                            "Show the problem description in the file's comment"
                        ],
                        "scope": "application",
                        "description": "Specify where to show the description."
                    },
                    "leetcodeStudyPlan.showCommentDescription": {
                        "type": "boolean",
                        "default": false,
                        "scope": "application",
                        "description": "[Deprecated] Include problem description in comments.",
                        "deprecationMessage": "This setting will be deprecated in 0.17.0, please use 'leetcodeStudyPlan.showDescription' instead"
                    },
                    "leetcodeStudyPlan.hint.setDefaultLanguage": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "Show a hint to set the default language."
                    },
                    "leetcodeStudyPlan.hint.configWebviewMarkdown": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "Show a hint to change webview appearance through markdown config."
                    },
                    "leetcodeStudyPlan.hint.commentDescription": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "Show a hint to enable comment description in solution code file."
                    },
                    "leetcodeStudyPlan.hint.commandShortcut": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "Show a hint to configure commands key binding."
                    },
                    "leetcodeStudyPlan.useWsl": {
                        "type": "boolean",
                        "default": false,
                        "scope": "application",
                        "description": "Use the Windows Subsystem for Linux."
                    },
                    "leetcodeStudyPlan.endpoint": {
                        "type": "string",
                        "default": "leetcode",
                        "scope": "application",
                        "enum": [
                            "leetcode",
                            "leetcode-cn"
                        ],
                        "description": "Endpoint of the user account."
                    },
                    "leetcodeStudyPlan.useEndpointTranslation": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "Use endpoint's translation (if available)"
                    },
                    "leetcodeStudyPlan.workspaceFolder": {
                        "type": "string",
                        "scope": "application",
                        "description": "The path of the workspace folder to store the problem files.",
                        "default": ""
                    },
                    "leetcodeStudyPlan.filePath": {
                        "type": "object",
                        "scope": "application",
                        "description": "The output folder and filename to save the problem files.",
                        "properties": {
                            "default": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string",
                                        "examples": [
                                            "src"
                                        ]
                                    },
                                    "filename": {
                                        "type": "string",
                                        "examples": [
                                            "${camelCaseName}.${ext}",
                                            "${PascalCaseName}.${ext}",
                                            "${id}-${kebab-case-name}.${ext}",
                                            "${id}_${snake_case_name}.${ext}"
                                        ]
                                    }
                                },
                                "required": [
                                    "folder",
                                    "filename"
                                ]
                            },
                            "bash": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "c": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "cpp": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "csharp": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "golang": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "java": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "javascript": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "kotlin": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "mysql": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "php": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "python": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "python3": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "ruby": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "rust": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "scala": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            },
                            "swift": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string"
                                    },
                                    "filename": {
                                        "type": "string"
                                    }
                                },
                                "minProperties": 1
                            }
                        },
                        "additionalProperties": {
                            "type": "object",
                            "properties": {
                                "folder": {
                                    "type": "string"
                                },
                                "filename": {
                                    "type": "string"
                                }
                            },
                            "minProperties": 1
                        },
                        "default": {
                            "default": {
                                "folder": "",
                                "filename": "${id}.${kebab-case-name}.${ext}"
                            }
                        }
                    },
                    "leetcodeStudyPlan.enableStatusBar": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "Show the LeetCode status bar or not."
                    },
                    "leetcodeStudyPlan.editor.shortcuts": {
                        "type": "array",
                        "default": [
                            "submit",
                            "test"
                        ],
                        "scope": "application",
                        "items": {
                            "type": "string",
                            "enum": [
                                "submit",
                                "test",
                                "star",
                                "solution",
                                "description"
                            ],
                            "enumDescriptions": [
                                "Submit your answer to LeetCode.",
                                "Test your answer with customized test cases.",
                                "Star or unstar the current problem.",
                                "Show the top voted solution for the current problem.",
                                "Show the problem description page."
                            ]
                        },
                        "description": "Customize the shortcuts in editors."
                    },
                    "leetcodeStudyPlan.enableSideMode": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "Determine whether to group all webview pages into the second editor column when solving problems."
                    },
                    "leetcodeStudyPlan.nodePath": {
                        "type": "string",
                        "default": "node",
                        "scope": "application",
                        "description": "The Node.js executable path. for example, C:\\Program Files\\nodejs\\node.exe"
                    },
                    "leetcodeStudyPlan.colorizeProblems": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "Add difficulty badge and colorize problems files in explorer tree."
                    },
                    "leetcodeStudyPlan.problems.sortStrategy": {
                        "type": "string",
                        "default": "None",
                        "scope": "application",
                        "enum": [
                            "None",
                            "Acceptance Rate (Ascending)",
                            "Acceptance Rate (Descending)"
                        ],
                        "description": "Sorting strategy for problems list."
                    },
                    "leetcodeStudyPlan.allowReportData": {
                        "type": "boolean",
                        "default": false,
                        "scope": "application",
                        "description": "Allow LeetCode to report anonymous usage data to improve the product."
                    },
                    "leetcodeStudyPlan.dailyPlan.path": {
                        "type": "string",
                        "default": "data/custom-plan.json",
                        "scope": "resource",
                        "description": "Workspace-relative study plan JSON path. Falls back to data/notion-plan.json when the default file is missing."
                    }
                }
            }
        ],
        "viewsWelcome": [
            {
                "view": "leetCodeStudyPlanDailyPlan",
                "contents": "Create data/custom-plan.json in your workspace, or select an existing plan.\n[Select Study Plan JSON](command:leetcodeStudyPlan.dailyPlan.selectPlan)"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "tslint --project tsconfig.json -e \"src/*.d.ts\" -t verbose",
        "build": "npx --yes @vscode/vsce@4.0.0 package",
        "vs-publish": "vsce publish",
        "test:daily-plan": "node --test test/daily-plan.test.js",
        "test": "npm run compile && node --test test/*.test.js",
        "test:host": "npm run compile && node test/run-host.js",
        "test:identity": "node --test test/identity.test.js"
    },
    "devDependencies": {
        "@types/fs-extra": "^9.0.11",
        "@types/lodash": "^4.14.170",
        "@types/markdown-it": "0.0.7",
        "@types/mocha": "^2.2.42",
        "@types/node": "^14.14.33",
        "@types/require-from-string": "^1.2.0",
        "@types/vscode": "1.57.0",
        "tslint": "^5.20.1",
        "typescript": "^4.3.2"
    },
    "dependencies": {
        "axios": "^1.6.8",
        "fs-extra": "^10.0.0",
        "highlight.js": "^10.7.2",
